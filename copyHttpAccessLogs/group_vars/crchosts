oscpClusterName: k8st
##
## Namespaces on which the backup/restore will be performed
oscpNamespaces:
  - name: "dxg"
    deployment: "dx-green"
oscpCoreContainerName: core
##
## OpenShift client to be used
oscpClientBin: "/usr/local/bin/oc"
##
## Logout of the OC command shell at the end?
oscpLogoutOfOc: true
##
## Target directory for backups. This is also the locations for the files to restore!
backupBaseDir: "/tmp/syndication/accesslogs"
backupFilePattern: "/opt/HCL/logs/WebSphere_Portal/https_access_*.log"
##
## How long too keep old backups (in days)
backupRetentionPeriod: 90
